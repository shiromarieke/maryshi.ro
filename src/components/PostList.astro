---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import categories from '../data/categories.json';

interface Props {
	posts: CollectionEntry<'posts'>[];
}

const posts = [...Astro.props.posts].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Group by year, newest first.
const years = new Map<number, typeof posts>();
for (const post of posts) {
	const year = post.data.date.getUTCFullYear();
	years.set(year, [...(years.get(year) ?? []), post]);
}

const day = (date: Date) => date.toLocaleDateString('en', { month: 'short', day: 'numeric', timeZone: 'UTC' });
const categoryName = (slug?: string) => categories.find((c) => c.slug === slug)?.name;
const excerpt = (text = '') => (text.length > 140 ? `${text.slice(0, 140).replace(/\s+\S*$/, '')} …` : text);
---

<div class="years">
	{
		[...years].map(([year, list]) => (
			<section id={`y${year}`}>
				<h2>
					{year} <span>{list.length === 1 ? '1 post' : `${list.length} posts`}</span>
				</h2>
				<ul class="tiles">
					{list.map((post) => (
						<li>
							<a href={`/${post.id}/`} class="tile">
								<span class="visual">
									{post.data.cover ? (
										<Image src={post.data.cover} alt="" width={480} />
									) : (
										<span class="quote">“{excerpt(post.data.description)}”</span>
									)}
								</span>
								<span class="title" lang={post.data.lang}>
									{post.data.title}
								</span>
								<span class="meta">
									{day(post.data.date)}
									{categoryName(post.data.categories[0]) && ` · ${categoryName(post.data.categories[0])}`}
								</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		))
	}
</div>

<style>
	.years {
		display: flex;
		flex-direction: column;
		gap: 56px;
	}
	section {
		scroll-margin-top: 24px;
	}
	h2 {
		margin: 0 0 20px;
		font-size: 44px;
		font-weight: 400;
		line-height: 1;
	}
	h2 span {
		font-size: 22px;
		color: var(--ink-soft);
	}
	.tiles {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
		gap: 36px 28px;
	}
	.tile {
		display: flex;
		flex-direction: column;
		gap: 2px;
		text-decoration: none;
	}
	.tile:hover {
		background: none;
	}
	/* Fixed-height area so titles line up; the image keeps its own shape inside it. */
	.visual {
		height: 200px;
		margin-bottom: 10px;
		display: flex;
		align-items: flex-end;
		justify-content: flex-start;
	}
	.visual :global(img),
	.quote {
		display: block;
		max-width: 100%;
		max-height: 100%;
		width: auto;
		height: auto;
		border: 2px solid var(--ink);
		box-shadow: var(--shadow-light);
		transition:
			transform 120ms steps(2),
			box-shadow 120ms steps(2);
	}
	.quote {
		box-sizing: border-box;
		width: 100%;
		padding: 14px 16px;
		background: rgba(255, 255, 255, 0.5);
		font-size: 20px;
		line-height: 1.2;
		overflow: hidden;
	}
	.tile:hover .visual :global(img),
	.tile:hover .quote {
		transform: translate(-2px, -2px);
		box-shadow: var(--shadow);
	}
	.title {
		line-height: 1.1;
	}
	.tile:hover .title {
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 4px;
	}
	.meta {
		font-size: 19px;
		color: var(--ink-soft);
	}
	/* Phones: two columns with smaller images. */
	@media (max-width: 520px) {
		.tiles {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 28px 18px;
		}
		.visual {
			height: 140px;
		}
		.title {
			font-size: 21px;
		}
		.meta {
			font-size: 17px;
		}
		.quote {
			padding: 8px 10px;
			font-size: 17px;
		}
	}
</style>
