---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import categories from '../data/categories.json';

interface Props {
	posts: CollectionEntry<'posts'>[];
}

const posts = [...Astro.props.posts].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Group by year, newest first.
const years = new Map<number, typeof posts>();
for (const post of posts) {
	const year = post.data.date.getUTCFullYear();
	years.set(year, [...(years.get(year) ?? []), post]);
}

const day = (date: Date) => date.toLocaleDateString('en', { month: 'short', day: 'numeric', timeZone: 'UTC' });
const categoryName = (slug?: string) => categories.find((c) => c.slug === slug)?.name;
const excerpt = (text = '') => (text.length > 160 ? `${text.slice(0, 160).replace(/\s+\S*$/, '')} …` : text);
---

<div class="years">
	{
		[...years].map(([year, list]) => (
			<section id={`y${year}`}>
				<h2>
					{year} <span>{list.length === 1 ? '1 post' : `${list.length} posts`}</span>
				</h2>
				<ul class="cards">
					{list.map((post) => (
						<li>
							<a href={`/${post.id}/`} class="card">
								{post.data.cover ? (
									<Image
										src={post.data.cover}
										alt=""
										width={640}
										class:list={['visual', { fit: post.data.coverFit }]}
									/>
								) : (
									<span class="visual quote">“{excerpt(post.data.description)}”</span>
								)}
								<span class="body">
									<span class="meta">
										{day(post.data.date)}
										{categoryName(post.data.categories[0]) && ` · ${categoryName(post.data.categories[0])}`}
									</span>
									<span class="title" lang={post.data.lang}>
										{post.data.title}
									</span>
								</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		))
	}
</div>

<style>
	.years {
		display: flex;
		flex-direction: column;
		gap: 56px;
	}
	section {
		scroll-margin-top: 24px;
	}
	h2 {
		margin: 0 0 20px;
		font-size: 44px;
		font-weight: 400;
		line-height: 1;

		span {
			font-size: 22px;
			color: var(--ink-soft);
		}
	}
	.cards {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 28px;

		@media (max-width: 520px) {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	.card {
		height: 100%;
		display: flex;
		flex-direction: column;
		border: 3px solid var(--ink);
		background: rgba(255, 255, 255, 0.55);
		box-shadow: var(--shadow-light);
		text-decoration: none;
		transition:
			transform 120ms steps(2),
			box-shadow 120ms steps(2);

		&:hover {
			background: rgba(255, 255, 255, 0.75);
			transform: translate(-3px, -3px);
			box-shadow: 7px 7px 0 0 var(--ink);

			.title {
				text-decoration: underline;
				text-decoration-thickness: 2px;
				text-underline-offset: 4px;
			}
		}
	}
	.visual {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-bottom: 3px solid var(--ink);

		/* coverFit: true in a post's front matter */
		&.fit {
			object-fit: contain;
			background: transparent;
		}
	}
	.quote {
		display: flex;
		align-items: center;
		padding: 20px 22px;
		background: rgba(237, 194, 232, 0.35);
		font-size: 22px;
		line-height: 1.2;
		overflow: hidden;
	}
	.body {
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding: 12px 16px 16px;
	}
	.meta {
		font-size: 19px;
		color: var(--ink-soft);
	}
	.title {
		line-height: 1.1;
	}
</style>
