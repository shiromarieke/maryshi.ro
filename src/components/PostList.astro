---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
	posts: CollectionEntry<'posts'>[];
}

const posts = [...Astro.props.posts].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Group by year, newest first.
const years = new Map<number, typeof posts>();
for (const post of posts) {
	const year = post.data.date.getUTCFullYear();
	years.set(year, [...(years.get(year) ?? []), post]);
}

const day = (date: Date) => date.toISOString().slice(5, 10).replace('-', '.');
---

{
	[...years].map(([year, list]) => (
		<section class="year">
			<h2>{year}</h2>
			<ul>
				{list.map((post) => (
					<li>
						<a href={`/${post.id}/`} class="thumb" tabindex="-1" aria-hidden="true">
							{post.data.cover && <Image src={post.data.cover} alt="" width={128} />}
						</a>
						<div>
							<a href={`/${post.id}/`} class="title" lang={post.data.lang}>
								{post.data.title}
							</a>
							<time datetime={post.data.date.toISOString()}>{day(post.data.date)}</time>
						</div>
					</li>
				))}
			</ul>
		</section>
	))
}

<style>
	.year + .year {
		margin-top: 40px;
	}
	h2 {
		margin: 0 0 12px;
		font-size: 36px;
		font-weight: 400;
		line-height: 1;
	}
	ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 14px;
	}
	li {
		display: grid;
		grid-template-columns: 56px minmax(0, 1fr);
		align-items: center;
		gap: 16px;
	}
	.thumb {
		display: block;
		width: 56px;
		height: 56px;
		border: 2px solid var(--ink);
		background: rgba(255, 255, 255, 0.45);
		box-shadow: var(--shadow-light);
		overflow: hidden;
	}
	.thumb:hover {
		background: rgba(255, 255, 255, 0.45);
	}
	.thumb :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.title {
		display: block;
		line-height: 1.1;
	}
	time {
		color: var(--ink-soft);
		font-size: 20px;
	}
</style>
