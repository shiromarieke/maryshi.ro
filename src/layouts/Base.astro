---
interface Props {
	title?: string;
	description?: string;
	lang?: string;
}

const { title, description, lang = 'en' } = Astro.props;
const siteTitle = 'Marie Gutbub';
const nav = [
	{ href: '/', label: 'Home' },
	{ href: '/talks/', label: 'Talks' },
	{ href: '/trainings/', label: 'Trainings & Workshops' },
	{ href: '/about/', label: 'About' },
	{ href: '/contact/', label: 'Contact' },
	{ href: 'https://thestickerarchive.tumblr.com/', label: 'Sticker archive' },
];
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{title ? `${title} – ${siteTitle}` : siteTitle}</title>
		{description && <meta name="description" content={description} />}
	</head>
	<body>
		<header>
			<a class="site-title" href="/">{siteTitle}</a>
			<p class="tagline">Communication · Campaigns · Events · Training</p>
			<nav>
				{nav.map((item) => <a href={item.href}>{item.label}</a>)}
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer>© {new Date().getFullYear()} {siteTitle}</footer>
	</body>
</html>

<style is:global>
	/* Placeholder styling until the new design exists. */
	body {
		max-width: 48rem;
		margin: 0 auto;
		padding: 0 1rem;
		font: 1.0625rem/1.6 system-ui, sans-serif;
		color: #222;
		background: #fff;
	}
	img,
	iframe {
		max-width: 100%;
		height: auto;
	}
	iframe {
		aspect-ratio: 16 / 9;
	}
	header {
		padding: 2rem 0 1rem;
		border-bottom: 1px solid #ddd;
	}
	.site-title {
		font-size: 1.5rem;
		font-weight: bold;
		color: inherit;
		text-decoration: none;
	}
	.tagline {
		margin: 0.25rem 0 1rem;
		color: #666;
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
	}
	footer {
		margin: 3rem 0 2rem;
		color: #666;
		font-size: 0.875rem;
	}
	table {
		border-collapse: collapse;
	}
	td,
	th {
		border: 1px solid #ddd;
		padding: 0.5rem;
		vertical-align: top;
	}
</style>
