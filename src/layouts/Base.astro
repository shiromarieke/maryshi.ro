---
import '../styles/global.css';
import Vignette from '../components/Vignette.astro';
import { site, nav, social } from '../site';

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	/** Front page: no header and footer, the page brings its own links. */
	bare?: boolean;
	/** Wider content column, for tile grids. */
	wide?: boolean;
}

const { title, description = site.description, lang = 'en', bare = false, wide = false } = Astro.props;
const path = Astro.url.pathname;
const current = path.startsWith('/category/') ? '/archive/' : path;

// Social previews need absolute URLs, so these point to the live domain (astro.config `site`).
const fullTitle = title ? `${title} – ${site.name}` : site.name;
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${site.name}, aka shiro: privacy, information security & digital rights`} />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		{
			bare ? (
				<slot />
			) : (
				<div class:list={['page', { wide }]}>
					<header class="site-header">
						<a href="/" class="home" aria-label={`${site.name}, home`}>
							<Vignette size={51} />
						</a>
						<nav aria-label="Pages">
							<ul class="link-row">
								{nav.map((item) => (
									<li>
										<a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>
											{item.label}
										</a>
									</li>
								))}
							</ul>
						</nav>
					</header>
					<main>
						<slot />
					</main>
					<footer class="site-footer">
						<ul class="link-row">
							{social.map((item) => (
								<li>
									<a href={item.href} rel={item.rel}>
										{item.label} ↗
									</a>
								</li>
							))}
						</ul>
					</footer>
				</div>
			)
		}
	</body>
</html>

<style>
	.page {
		max-width: var(--measure);
		margin: 0 auto;
		padding: 40px 24px 48px;

		&.wide {
			max-width: 1120px;
		}
	}
	.site-header {
		display: flex;
		align-items: center;
		gap: 24px;
		margin-bottom: 48px;

		nav {
			font-size: 26px;
		}
		@media (max-width: 520px) {
			align-items: flex-start;
			gap: 16px;
		}
	}
	.home {
		flex: 0 0 auto;
		border-radius: 50%;
	}
	.site-footer {
		margin-top: 72px;
		font-size: 22px;
	}
</style>
