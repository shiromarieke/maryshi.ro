---
import '../styles/global.css';
import Vignette from '../components/Vignette.astro';
import { site, nav, social } from '../site';

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	/** Front page: no header and footer, the page brings its own links. */
	bare?: boolean;
	/** Wider content column, for tile grids. */
	wide?: boolean;
}

const { title, description = site.description, lang = 'en', bare = false, wide = false } = Astro.props;
const path = Astro.url.pathname;
const current = path.startsWith('/category/') ? '/archive/' : path;
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<title>{title ? `${title} – ${site.name}` : site.name}</title>
		<meta name="description" content={description} />
	</head>
	<body>
		{
			bare ? (
				<slot />
			) : (
				<div class:list={['page', { wide }]}>
					<header class="site-header">
						<a href="/" class="home" aria-label={`${site.name}, home`}>
							<Vignette size={51} />
						</a>
						<nav aria-label="Pages">
							<ul class="link-row">
								{nav.map((item) => (
									<li>
										<a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>
											{item.label}
										</a>
									</li>
								))}
							</ul>
						</nav>
					</header>
					<main>
						<slot />
					</main>
					<footer class="site-footer">
						<ul class="link-row">
							{social.map((item) => (
								<li>
									<a href={item.href} rel={item.rel}>
										{item.label} ↗
									</a>
								</li>
							))}
						</ul>
					</footer>
				</div>
			)
		}
	</body>
</html>

<style>
	.page {
		max-width: var(--measure);
		margin: 0 auto;
		padding: 40px 24px 48px;

		&.wide {
			max-width: 1120px;
		}
	}
	.site-header {
		display: flex;
		align-items: center;
		gap: 24px;
		margin-bottom: 48px;

		nav {
			font-size: 26px;
		}
		@media (max-width: 520px) {
			align-items: flex-start;
			gap: 16px;
		}
	}
	.home {
		flex: 0 0 auto;
		border-radius: 50%;
	}
	.site-footer {
		margin-top: 72px;
		font-size: 22px;
	}
</style>
