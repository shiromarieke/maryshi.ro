---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import categories from '../data/categories.json';

// Posts and pages share the URL space /<slug>/, as on the old WordPress site.
export async function getStaticPaths() {
	const posts = await getCollection('posts');
	const pages = await getCollection('pages');
	return [
		...posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } })),
		...pages.map((entry) => ({ params: { slug: entry.id }, props: { entry } })),
	];
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const post = entry.collection === 'posts' ? entry : undefined;
const categoryName = (slug: string) => categories.find((c) => c.slug === slug)?.name ?? slug;
---

<Base title={entry.data.title} description={post?.data.description} lang={entry.data.lang}>
	<article>
		<header>
			<h1>{entry.data.title}</h1>
			{
				post && (
					<p class="meta">
						<time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10)}</time>
						{post.data.categories.map((slug) => (
							<>
								{' · '}
								<a href={`/category/${slug}/`}>{categoryName(slug)}</a>
							</>
						))}
					</p>
				)
			}
		</header>
		<div class="prose">
			<Content />
		</div>
		{
			post && (
				<p class="back">
					<a href="/archive/">← All posts</a>
				</p>
			)
		}
	</article>
</Base>

<style>
	header {
		margin-bottom: 32px;
	}
	h1 {
		margin: 0;
		font-size: 48px;
		font-weight: 400;
		line-height: 1;
	}
	.meta {
		margin: 10px 0 0;
		font-size: 22px;
		color: var(--ink-soft);
	}
	.meta a {
		color: var(--ink-soft);
	}
	.back {
		margin-top: 48px;
	}
</style>
