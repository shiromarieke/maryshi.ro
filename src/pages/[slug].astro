---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import categories from '../data/categories.json';

// Posts and pages share the URL space /<slug>/, as on the old WordPress site.
export async function getStaticPaths() {
	const posts = await getCollection('posts');
	const pages = await getCollection('pages');
	return [
		...posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } })),
		...pages.map((entry) => ({ params: { slug: entry.id }, props: { entry } })),
	];
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const isPost = entry.collection === 'posts';
const categoryName = (slug: string) => categories.find((c) => c.slug === slug)?.name ?? slug;
---

<Base title={entry.data.title} description={isPost ? entry.data.description : undefined} lang={entry.data.lang}>
	<article>
		<h1>{entry.data.title}</h1>
		{
			isPost && (
				<p class="meta">
					<time datetime={entry.data.date.toISOString()}>{entry.data.date.toISOString().slice(0, 10)}</time>
					{entry.data.categories.map((slug) => (
						<>
							{' · '}
							<a href={`/category/${slug}/`}>{categoryName(slug)}</a>
						</>
					))}
				</p>
			)
		}
		<Content />
	</article>
</Base>

<style>
	.meta {
		color: #666;
		font-size: 0.875rem;
	}
</style>
