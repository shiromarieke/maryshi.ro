---
import Base from '../layouts/Base.astro';
import Vignette from '../components/Vignette.astro';
import { nav, social } from '../site';
---

<Base bare>
	<div class="front">
	<main>
		<Vignette size={150} />
		<div class="intro">
			<p>
				Hi, I'm Marie, or shiro, depending on where I am and who you ask. I work on privacy, information security
				and digital rights, and help journalists and activists protect themselves and their sources.
			</p>
			<nav aria-label="Pages">
				<ul class="link-row pages">
					{
						nav.map((item) => (
							<li>
								<a href={item.href}>{item.label}</a>
							</li>
						))
					}
				</ul>
			</nav>
			<nav aria-label="Elsewhere">
				<ul class="link-row elsewhere">
					{
						social.map((item) => (
							<li>
								<a href={item.href} rel={item.rel}>
									{item.label} ↗
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</div>
	</main>
	</div>
</Base>

<style>
	/* On narrow screens the picture sits above the text, so both start at the top. */
	.front {
		min-height: 100vh;
		padding: 48px 24px;
		display: flex;
		align-items: center;
		justify-content: center;

		@media (max-width: 680px) {
			align-items: flex-start;
		}
	}
	main {
		width: 100%;
		max-width: 760px;
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: center;
		gap: 40px;

		:global(.vignette) {
			margin-top: 4px;
		}
		@media (max-width: 680px) {
			justify-content: flex-start;
		}
	}
	.intro {
		flex: 1 1 360px;
		max-width: 520px;
		display: flex;
		flex-direction: column;
		gap: 18px;

		p {
			margin: 0;
			font-size: 26px;
			line-height: 1.25;
		}
	}
	.pages {
		font-size: 26px;
		padding-top: 4px;
	}
	.elsewhere {
		font-size: 22px;
	}
</style>
